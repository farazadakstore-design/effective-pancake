<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Dept settings -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">

            <TextView android:id="@+id/tvSettingsTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" android:textColor="@color/primary_dark" android:textSize="15sp" android:textStyle="bold" />

            <TextView android:id="@+id/tvPwSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.05" />
            <LinearLayout android:id="@+id/pwContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="vertical" />

            <TextView android:id="@+id/tvShiftSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                <Button android:id="@+id/btnCheckInTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/bg_edittext" android:textAllCaps="false" android:textColor="@color/text_main" />
                <Button android:id="@+id/btnCheckOutTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="8dp" android:background="@drawable/bg_edittext" android:textAllCaps="false" android:textColor="@color/text_main" />
            </LinearLayout>

            <TextView android:id="@+id/tvBreakSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
            <EditText android:id="@+id/etBreakMinutes" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:background="@drawable/bg_edittext" android:inputType="number" android:padding="9dp" />

            <Button android:id="@+id/btnSaveSettings" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/btn_primary" android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold"
                android:paddingTop="11dp" android:paddingBottom="11dp" />
            <TextView android:id="@+id/tvSettingsMsg" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/bg_msg_ok" android:padding="9dp" android:textStyle="bold" android:visibility="gone" />

            <TextView android:id="@+id/tvAdminPwTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
            <EditText android:id="@+id/etAdminPwNew" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:background="@drawable/bg_edittext" android:inputType="textPassword" android:padding="9dp" />
            <Button android:id="@+id/btnChangeAdminPw" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/btn_secondary" android:textAllCaps="false" android:paddingStart="14dp" android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- Add technician -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">

            <TextView android:id="@+id/tvAddTechTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:textColor="@color/primary_dark" android:textSize="15sp" android:textStyle="bold" />

            <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:background="@drawable/bg_edittext" android:padding="9dp" android:textSize="14sp" />
            <EditText android:id="@+id/etNameAr" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:background="@drawable/bg_edittext" android:padding="9dp" android:textSize="14sp" />
            <Spinner android:id="@+id/spDept" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:background="@drawable/bg_edittext" android:padding="9dp" />
            <EditText android:id="@+id/etFileNo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:background="@drawable/bg_edittext" android:inputType="number" android:padding="9dp" android:textSize="14sp" />
            <EditText android:id="@+id/etWa" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:background="@drawable/bg_edittext" android:inputType="phone" android:padding="9dp" android:textSize="14sp" />
            <EditText android:id="@+id/etNat" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:background="@drawable/bg_edittext" android:padding="9dp" android:textSize="14sp" />

            <Button android:id="@+id/btnAddTech" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/btn_primary" android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold"
                android:paddingTop="11dp" android:paddingBottom="11dp" />
            <TextView android:id="@+id/tvAddTechMsg" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/bg_msg_ok" android:padding="9dp" android:textStyle="bold" android:visibility="gone" />

            <TextView android:id="@+id/tvExtraTechsTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvExtraTechs" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- All reports -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
            <TextView android:id="@+id/tvAllReportsTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:textColor="@color/primary_dark" android:textSize="15sp" android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAllReports" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- All evaluations -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
            <TextView android:id="@+id/tvAllEvalTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:textColor="@color/primary_dark" android:textSize="15sp" android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAllEval" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
