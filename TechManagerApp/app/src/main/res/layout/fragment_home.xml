<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/statsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvTechniciansTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/primary_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/addTechCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvAddTechTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/primary_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:background="@drawable/bg_edittext" android:padding="9dp" android:textSize="14sp" />
            <EditText android:id="@+id/etNameAr" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:background="@drawable/bg_edittext" android:padding="9dp" android:textSize="14sp" />
            <EditText android:id="@+id/etFileNo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:background="@drawable/bg_edittext" android:inputType="number" android:padding="9dp" android:textSize="14sp" />
            <EditText android:id="@+id/etWa" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:background="@drawable/bg_edittext" android:inputType="phone" android:padding="9dp" android:textSize="14sp" />
            <EditText android:id="@+id/etNat" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:background="@drawable/bg_edittext" android:padding="9dp" android:textSize="14sp" />

            <Button
                android:id="@+id/btnAddTech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_primary"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAddTechMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_msg_ok"
                android:padding="9dp"
                android:textColor="@color/badge_avail_text"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
