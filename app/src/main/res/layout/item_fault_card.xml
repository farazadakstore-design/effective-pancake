<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_fault_card"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtCardLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/text_main" />

        <TextView
            android:id="@+id/btnRemove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="@color/danger"
            android:textSize="18sp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <EditText
        android:id="@+id/inputDescription"
        style="@style/FieldInput"
        android:layout_marginTop="8dp"
        android:minLines="2"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:hint="@string/fault_desc_hint" />

    <TextView style="@style/FieldLabel" android:text="@string/repair_label" />

    <EditText
        android:id="@+id/inputRepair"
        style="@style/FieldInput"
        android:minLines="2"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:hint="@string/repair_hint" />

    <LinearLayout
        android:id="@+id/photosRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp" />
</LinearLayout>
